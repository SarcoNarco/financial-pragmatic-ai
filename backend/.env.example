# Backend currently requires no environment variables for local startup.
# HF_HOME is set by backend/api/server.py with a default of /tmp/hf_cache.
#
# Optional local/deployment port override.
# Hugging Face Spaces uses 7860 by default.
# Railway usually injects PORT automatically.
# PORT=7860
# PORT=8000
#
# Optional override if your deployment needs a custom Hugging Face cache path:
# HF_HOME=/tmp/hf_cache
