# Backend currently requires no environment variables for local startup.
# HF_HOME is set by backend/api/server.py with a default of /tmp/hf_cache.
#
# Optional local/deployment port override.
# Railway injects PORT automatically; local Docker defaults to 8000.
# PORT=8000
#
# Optional override if your deployment needs a custom Hugging Face cache path:
# HF_HOME=/tmp/hf_cache
#
# Long transcripts above this threshold use representative segment sampling.
# MAX_DIRECT_TRANSCRIPT_CHARS=20000
#
# Maximum number of parsed segments analyzed for sampled full transcripts.
# FULL_TRANSCRIPT_SEGMENT_BUDGET=32
#
# Absolute request safety cap. MAX_TRANSCRIPT_CHARS is supported as a legacy
# alias for MAX_DIRECT_TRANSCRIPT_CHARS only.
# MAX_FULL_TRANSCRIPT_CHARS=250000
#
# Do not set unnecessary secrets for the backend service.
